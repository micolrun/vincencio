APP_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://127.0.0.1:8010

# Google login (optional in local demo mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub repository export (separate OAuth connection)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REPOSITORY=

# AI generation. Leave empty to use demo mode.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
TEXT_MODEL=gpt-4.1-mini
IMAGE_MODEL=gpt-image-1
ALLOWED_ORIGINS=https://micolrun.github.io

# Rendering
REMOTION_ENABLED=true
REMOTION_COMMAND=npm run render
